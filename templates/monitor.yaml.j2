#cloud-config

users:
- name: ubuntu
  # yaml-language-server-disable Array
  ssh_authorized_keys: []
- name: prometheus
  system: true
  no_create_home: true
  shell: /usr/sbin/nologin

write_files:
- path: /etc/systemd/system/prometheus.service
  content: |
{{ read("prometheus/prometheus.service") | indent(4, true) }}

# /etc/prometheus and prometheus.yml will be owned by root:root
# with 0644 permissions; might be switched to prometheus:prometheus later
- path: /etc/prometheus/prometheus.yml
  # defer: true
  content: |
{{ read("prometheus/prometheus.yml") | indent(4, true) }}

- path: /scripts/install.sh
  content: |
{{ read("scripts/install.sh") | indent(4, true) }}

# Prometheus resolves via the systemd-resolved, not NSS/avahi, so resolved must do mDNS for target.local
# lookups + announcing this host as monitor.local
- path: /etc/systemd/resolved.conf.d/mdns.conf
  content: |
    [Resolve]
    MulticastDNS=yes

# Link-level: actually turns mDNS on for enp0s1
- path: /etc/systemd/network/10-netplan-default.network.d/mdns.conf
  content: |
    [Network]
    MulticastDNS=yes

- path: /etc/chrony/conf.d/makestep.conf
  content: |
    makestep 1.0 -1

runcmd:
- [systemctl, restart, systemd-resolved]
- [networkctl, reload]
- [networkctl, reconfigure, enp0s1]
- [sh, /scripts/install.sh, 3.15.1, arm64, prometheus]
- install -d -o prometheus -g prometheus -m 0755 /var/lib/prometheus
- [systemctl, daemon-reload]
- [systemctl, enable, --now, prometheus]