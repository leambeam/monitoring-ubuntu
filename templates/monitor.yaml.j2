#cloud-config

users:
- name: ubuntu
  # yaml-language-server-disable Array
  ssh_authorized_keys: []
- name: prometheus
  system: true
  no_create_home: true
  shell: /usr/sbin/nologin
- name: alertmanager
  system: true
  no_create_home: true
  shell: /usr/sbin/nologin

write_files:
- path: /etc/systemd/system/prometheus.service
  content: |
{{ read("prometheus/prometheus.service") | indent(4, true) }}

# /etc/prometheus and prometheus.yml will be owned by root:root
# with 0644 permissions; might be switched to prometheus:prometheus later
- path: /etc/prometheus/prometheus.yml
  # defer: true
  content: |
{{ read("prometheus/prometheus.yml") | indent(4, true) }}

- path: /etc/prometheus/rules/node-alerts.yml
  content: |
{{ read("prometheus/rules/node-alerts.yml") | indent(4, true) }}

- path: /etc/systemd/system/alertmanager.service
  content: |
{{ read("alertmanager/alertmanager.service") | indent(4, true) }}

- path: /etc/alertmanager/alertmanager.yml
  content: |
{{ read("alertmanager/alertmanager.yml") | indent(4, true) }}

# Multipass strips quotes, so 0600 becomes a YAML int and fails the schema, 0o600 stays a string
- path: /etc/bot/bot-token.txt
  defer: true
  permissions: '0o640'
  owner: root:alertmanager
  content: |
{{ read(".env.tg").splitlines()[0].strip() | indent(4, true) }}

- path: /etc/bot/chat-id.txt
  defer: true
  permissions: '0o640'
  owner: root:alertmanager
  content: |
{{ read(".env.tg").splitlines()[1].strip() | indent(4, true) }}

- path: /etc/alertmanager/templates/telegram.tmpl
  content: |
{{ read ("alertmanager/templates/telegram.tmpl") | indent(4, true) }}

- path: /scripts/install.sh
  content: |
{{ read("scripts/install.sh") | indent(4, true) }}

- path: /scripts/install-grafana.sh
  content: |
{{ read("scripts/install-grafana.sh") | indent(4, true) }}

- path: /etc/grafana/provisioning/datasources/prometheus.yaml
  content: |
{{ read("grafana/provisioning/datasources/prometheus.yaml") | indent(4, true) }}

- path: /etc/grafana/provisioning/dashboards/default.yaml
  content: |
{{ read("grafana/provisioning/dashboards/default.yaml") | indent(4, true) }}

# Prometheus resolves via the systemd-resolved, not NSS/avahi, so resolved must do mDNS for target.local
# lookups + announcing this host as monitor.local
- path: /etc/systemd/resolved.conf.d/mdns.conf
  content: |
    [Resolve]
    MulticastDNS=yes

# Link-level: actually turns mDNS on for enp0s1
- path: /etc/systemd/network/10-netplan-default.network.d/mdns.conf
  content: |
    [Network]
    MulticastDNS=yes

- path: /etc/chrony/conf.d/makestep.conf
  content: |
    makestep 1.0 -1

runcmd:
- [systemctl, restart, systemd-resolved]
- [networkctl, reload]
- [networkctl, reconfigure, enp0s1]
- [sh, /scripts/install.sh, 3.15.1, arm64, prometheus]
- [sh, /scripts/install.sh, 0.35.0, arm64, alertmanager]
- sh /scripts/install-grafana.sh 13.3.0 40412481033 arm64
- install -d -o grafana -g grafana -m 0755 /var/lib/grafana/dashboards
- [wget, -q, -O, /var/lib/grafana/dashboards/node-exporter-full.json, https://grafana.com/api/dashboards/1860/revisions/46/download]
- [systemctl, daemon-reload]
- [systemctl, --now, enable, prometheus, grafana-server, alertmanager]
