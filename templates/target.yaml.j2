#cloud-config

users:
- name: ubuntu
  # yaml-language-server-disable Array
  ssh_authorized_keys: []
- name: node_exporter
  system: true
  no_create_home: true
  shell: /usr/sbin/nologin

packages:
- apt: [avahi-daemon]

write_files:
- path: /etc/systemd/system/node_exporter.service
  content: |
{{ read("node_exporter/node_exporter.service") | indent(4, true) }}

- path: /scripts/install.sh
  content: |
{{ read("scripts/install.sh") | indent(4, true) }}

- path: /etc/chrony/conf.d/makestep.conf
  content: |
    makestep 1.0 -1

runcmd:
- [systemctl, enable, --now, avahi-daemon]
- [sh, /scripts/install.sh, 1.12.1, arm64, node_exporter]
- [systemctl, daemon-reload]
- [systemctl, enable, --now, node_exporter]