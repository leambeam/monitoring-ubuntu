#cloud-config

users:
- name: ubuntu
  # yaml-language-server-disable Array
  ssh_authorized_keys: []
- name: node_exporter
  system: true
  no_create_home: true
  shell: /usr/sbin/nologin

packages:
- apt: [avahi-daemon]

write_files:
- path: /etc/systemd/system/node_exporter.service
  content: |
{{ read("node_exporter/node_exporter.service") | indent(4, true) }}

- path: /scripts/install-prom.sh
  content: |
{{ read("scripts/install-prom.sh") | indent(4, true) }}

- path: /etc/chrony/conf.d/makestep.conf
  content: |
    makestep 1.0 -1

- path: /etc/profile.d/cloud_init_status.sh
  content: |
    if [ -f "/home/ubuntu/.not_logged_in_yet" ]; then
      printf "\n***Cloud-init status***\n\n"
      cloud-init status --wait --long >&2
      rm "/home/ubuntu/.not_logged_in_yet"
    fi

- path: /home/ubuntu/.not_logged_in_yet
  owner: ubuntu:ubuntu
  defer: true

runcmd:
- [systemctl, enable, --now, avahi-daemon]
- [sh, /scripts/install-prom.sh, 1.12.1, arm64, node_exporter]
- [systemctl, daemon-reload]
- [systemctl, enable, --now, node_exporter]
