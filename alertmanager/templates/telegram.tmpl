{{ define "telegram.message" }}
{{- if eq .Status "firing" }}🚨 <b>FIRING</b>{{ else }}✅ <b>RESOLVED</b>{{ end }}
{{ range .Alerts }}
<b>{{ .Labels.alertname }}</b>
{{- if .Labels.severity }} ({{ .Labels.severity }}){{ end }}
{{- if .Annotations.summary }}
{{ .Annotations.summary }}
{{- end }}

<b>Host:</b> <code>{{ .Labels.instance }}</code>
<b>Since:</b> {{ .StartsAt.Format "15:04:05 02.01.2006" }}
{{- if eq .Status "resolved" }}
<b>Resolved:</b> {{ .EndsAt.Format "15:04:05 02.01.2006" }}
{{- end }}
<a href="{{ .GeneratorURL }}">Open in Prometheus</a>
{{ end }}
{{ end }}
